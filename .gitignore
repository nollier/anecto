node_modules/
.expo/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Clé privée du compte de service Firebase : accès admin au projet.
# À ne pas confondre avec google-services.json, qui est une configuration
# publique embarquée dans chaque APK et versionnée avec le reste.
*-adminsdk-*.json
firebase-adminsdk*.json

# Clé privée du compte de service Google Play : elle permet de publier une
# version sur le magasin. Nomme-la bien ainsi si tu la poses dans le projet —
# mieux vaut encore la charger chez EAS et ne jamais l'écrire ici.
play-service-account*.json
google-play-*.json
*.orig.*
web-build/
.env
.env.local

# Cache local de la CLI Supabase : versions consultées, projet lié, URL du
# pooler. Réécrit à chaque commande, propre à chaque poste, jamais du code.
# `supabase link --project-ref <ref>` le régénère sur un clone neuf.
supabase/.temp/
