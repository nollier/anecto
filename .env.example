# --- App (embarqué dans le bundle, ne jamais y mettre de secret) ---
EXPO_PUBLIC_SUPABASE_URL=https://swvhclxwchrhyhtrvmhb.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=colle_ta_cle_anon_ici

# --- Secrets Edge Functions ---
# À poser avec `npx supabase secrets set`, jamais dans un fichier versionné.
# GOOGLE_MAPS_API_KEY=          # Places API (New), sans restriction de référent
# DEEPSEEK_API_KEY=             # génération d'anecdotes
# ANECTO_ADMIN_SECRET=          # protège l'appel à generate-anecdote
# DEEPSEEK_MODEL=               # défaut : deepseek-chat
# DEEPSEEK_BASE_URL=            # défaut : https://api.deepseek.com
# ANECTO_PLACES_REGIONS=        # optionnel, ex. "FR,BE,CH" pour limiter les suggestions

# --- Alerte e-mail sur les retours des lecteurs (notify-feedback) ---
# SMTP_HOST=                    # ex. smtp.gmail.com
# SMTP_PORT=                    # défaut : 465 (TLS dès la connexion)
# SMTP_USER=                    # compte expéditeur
# SMTP_PASS=                    # mot de passe d'application, jamais celui du compte
# ANECTO_ALERT_EMAIL=           # destinataire des alertes
# ANECTO_FROM_EMAIL=            # expéditeur affiché ; défaut : SMTP_USER.
#                               # Chez Gmail, doit être un alias vérifié du
#                               # compte, sinon l'adresse est réécrite.

# --- Vault, côté base ---
# Deux secrets à poser en SQL, lus par les déclencheurs pg_cron :
#   select vault.create_secret('https://<ref>.supabase.co/functions/v1',
#                              'anecto_functions_url');
#   select vault.create_secret('<ANECTO_ADMIN_SECRET>', 'anecto_admin_secret');
# La seconde valeur doit être identique au secret ANECTO_ADMIN_SECRET ci-dessus.
