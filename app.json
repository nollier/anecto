{
  "expo": {
    "name": "Anecto",
    "slug": "anecto",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "anecto",
    "updates": {
      "url": "https://u.expo.dev/94da1ca3-603f-41f0-bb60-232e22221f04",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.anecto.app",
      "appStoreUrl": "https://apps.apple.com/fr/app/anecto/id6804257118",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleLocalizations": ["fr"]
      }
    },
    "android": {
      "package": "fr.anecto.app",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=fr.anecto.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "fr": {
        "ios": "./locales/fr.json"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#C7643F"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "94da1ca3-603f-41f0-bb60-232e22221f04"
      }
    },
    "owner": "nicoollier"
  }
}
